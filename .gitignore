# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments
.env
.env.*
!.env.example
!.env.sample
!.env.template
.venv/
.venv-*/
venv/

# Local secrets / credentials
.aws/
.ssh/
.mcp-auth/
*.pem
*.key
*.p12
*.pfx
*.der
*.crt
*.cer
*.jks
*.keystore
*.p8
*.token
*.secret
credentials*.json
*credentials*.json
*secret*.json

# Session data — large binary/generated artifacts, not source.
# Keep session_001 as a checked-in example fixture (see README quickstart);
# everything else under these roots is per-run output.
raw/*
!raw/session_001/
raw/session_001/raw.mp4
processed/*
!processed/.gitkeep
delivery/*
!delivery/.gitkeep

# Dense depth maps (v2 addendum §4) — large, opt-in via
# config.ENABLE_DENSE_DEPTH_MAPS, never meant to be checked in.
**/depth_maps/

# Per-device camera calibration may be hardware-specific / site-specific —
# track the example, not real rig files, unless your team decides otherwise.
calibration/*
!calibration/README.md
!calibration/example_device_intrinsics.json

# Logs
*.log

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
.env.local

# ---------------------------------------------------------------------------
# CONSENT-GATED CAPTURE DATA — NEVER COMMIT
# ---------------------------------------------------------------------------
# raw/ and processed/ hold real human capture (video, IMU, hand poses). The one
# capture we have carries consent=pending. The three-layer consent boundary
# guards S3 and the delivery bucket; it does NOT guard git. Nothing here goes to
# a remote. Raw provenance lives in s3://actuate-raw-<env>/, content-addressed.
raw/
processed/
delivery/
.export/
.actuate-store/
*.mp4
*.h5
*.npy
*.npz

# ---------------------------------------------------------------------------
# Local config + build artifacts (contain the AWS account id / DB URL)
# ---------------------------------------------------------------------------
.env.local
infra/cdk.out/
infra/cdk.context.json

# Rerun recordings — large binary viz artifacts, never commit
*.rrd

# Perception cache for `actuate viz --cache` (pickled stage outputs; large, per-session)
.actuate_cache/
out/
tmp/

# Local coding-agent state is not product source.
.agent-sessions/
.codex/
